# Copiar este archivo como .env y completar la API key
OPENAI_API_KEY=

# Configuración de OpenAI
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
PDF_DETAIL=low
MAX_PDF_PAGES=3
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=0

# Rutas locales relativas a la raíz del proyecto
PDF_DIRECTORY=data/pdf
REFERENCE_PATH=data/albaranes.json
HISTORY_PATH=runtime/resultados.json
